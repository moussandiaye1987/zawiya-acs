# =====================================================================
# Variables d'environnement — À RENSEIGNER DANS NETLIFY, PAS ICI
# Netlify : Site configuration → Environment variables
# Ce fichier ne contient que des exemples. Il ne doit jamais recevoir
# de vraie valeur, et il est le seul fichier .env suivi par Git.
# =====================================================================

# --- Base de données (obligatoire) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « service_role » : Supabase → Project Settings → API Keys.
# Elle contourne toutes les protections : elle ne doit jamais apparaître
# dans le navigateur, ni dans le dépôt, ni dans une capture d'écran.
SUPABASE_SERVICE_ROLE_KEY=

# --- Envoi des e-mails (fortement recommandé) ---
# Un seul des deux fournisseurs suffit.
# Brevo : 300 e-mails/jour gratuits, expéditeur validé par simple e-mail.
BREVO_API_KEY=
# Resend : 3 000/mois gratuits, nécessite un nom de domaine vérifié.
RESEND_API_KEY=

# Adresse d'expédition, à avoir vérifiée chez le fournisseur choisi.
MAIL_EXPEDITEUR=contact@connaissance-et-savoir.org
MAIL_EXPEDITEUR_NOM=Association Connaissance et Savoir

# Adresses internes qui reçoivent les notifications d'engagement et de
# Dahira : la notification de chaque nouvel adhérent, le récapitulatif
# des engagements à date et le CSV joint.
#
# Plusieurs adresses se séparent par une virgule. Elles partent dans un
# seul message : aucun envoi en double, une seule pièce jointe. La
# première reste l'adresse principale. Les doublons, les différences de
# casse et les adresses mal formées sont ignorés.
#
# Ces adresses ne sont jamais montrées aux adhérents, dont l'e-mail de
# confirmation ne contient que leurs propres informations.
EMAIL_ASSOCIATION=premiere@exemple.org, seconde@exemple.org

# --- HelloAsso (compteur d'adhérents) ---
# À créer dans HelloAsso : Mon association → Intégrations → API.
# Le secret n'est affiché qu'une fois, à la création.
# Sans ces trois variables, le compteur reste simplement masqué.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANISATION=association-connaissance-et-savoir

# Adresse exacte de la campagne d'adhésion. Vide, le bouton mène à la
# page publique de l'association, qui reste valable.
HELLOASSO_URL_ADHESION=

# Durée de validité d'une adhésion, en mois (12 par défaut).
HELLOASSO_DUREE_MOIS=12

# « oui » pour viser l'environnement d'essai HelloAsso.
HELLOASSO_BAC_A_SABLE=

# Information fiscale sur la page publique. À n'activer qu'une fois
# l'éligibilité de l'association ET des cotisations établie.
AFFICHER_INFO_FISCALE=

# --- Secrets techniques (obligatoires) ---
# Deux chaînes aléatoires distinctes. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEL_EMPREINTE=
SECRET_LIENS=
# Protège /api/rappels-test et /api/relance-whatsapp (page du bureau).
SECRET_ADMIN=
